# Copy to .env and fill in real values. Never commit .env (already covered by
# the repo-wide .gitignore rule for .env / .env.*).
#
# Generate strong values with:
#   openssl rand -base64 36 | tr -d '\n'   # for PG_PASS
#   openssl rand -base64 60 | tr -d '\n'   # for AUTHENTIK_SECRET_KEY

PG_DB=authentik
PG_USER=authentik
PG_PASS=changeme

AUTHENTIK_SECRET_KEY=changeme

# DO NOT UNCOMMENT on authentik 2026.5.5 (see docs/authentik.md Troubleshooting):
# confirmed to crash-loop authentik-server on a from-scratch install
# (EntryInvalidError: KeyOf: failed to find entry with id of 'admin-group').
# Use https://authentik.bitforge/if/flow/initial-setup/ instead.
# AUTHENTIK_BOOTSTRAP_EMAIL=admin@bitforge
# AUTHENTIK_BOOTSTRAP_PASSWORD=changeme

# Optional: disable anonymous error reporting to authentik's maintainers.
# AUTHENTIK_ERROR_REPORTING__ENABLED=false
